<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Platform theme only: all real styling happens in Compose (Material 3).
        Keeping the platform parent avoids pulling in the Material Components view library.
    -->
    <style name="Theme.OpencodeAndroid" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
