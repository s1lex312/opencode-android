    <!-- Hero -->
    <string name="setup_hero_title">Run opencode on this phone</string>
    <string name="setup_hero_body">The app sets up a small Linux environment in its private storage and starts opencode there. No root, no Termux, about 400 MB of space.</string>

    <!-- Banners -->
    <string name="setup_remote_banner_title">You\'re using a remote server</string>
    <string name="setup_remote_banner_body">The app currently talks to opencode on another machine. You can prepare this phone anyway and switch whenever you like — the remote address stays saved.</string>
    <string name="setup_broken_banner_title">This build lost its environment</string>
    <string name="setup_broken_banner_body">This Full APK was packaged without its environment bundle. Reinstall the Full APK from the latest release, or install a bundle file or link under Other sources.</string>
    <string name="setup_lite_banner_title">Bring your own bundle</string>
    <string name="setup_lite_banner_body">This Lite build doesn\'t include the environment. Pick a bundle file or paste a download link under Other sources — or use a remote server instead.</string>

