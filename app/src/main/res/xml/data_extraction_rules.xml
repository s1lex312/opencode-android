<?xml version="1.0" encoding="utf-8"?>
<!--
  Only the configuration snapshot written by OpencodeBackupAgent travels: raw app files would carry
  Keystore-encrypted secrets that no other install can read, and the ~300 MB environment lives in
  no_backup anyway.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="backup/cloud-snapshot.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="backup/cloud-snapshot.json" />
    </device-transfer>
</data-extraction-rules>
