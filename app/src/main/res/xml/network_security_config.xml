<?xml version="1.0" encoding="utf-8"?>
<!--
    Platform-level TLS policy. Certificate validation always uses the system trust store;
    user-installed CAs are not trusted (important when connecting to a remote opencode host).

    Cleartext is permitted at the platform level because Android's network security config
    cannot express "private network ranges only". The application-level NetworkPolicy
    (ai.opencode.android.security.NetworkPolicy) is the real gate: it allows https:// anywhere,
    plain http:// only for loopback and - when the user explicitly opts in - RFC1918/link-local
    LAN hosts. Cleartext to public hosts is rejected before a socket is opened.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
